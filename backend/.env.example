# TestPilot AI Environment Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# AI API Providers (Optional: TestPilot AI includes built-in offline heuristic engine)
# If provided, Gemini or OpenAI will be used for enhanced generative test planning
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default AI Provider: "hybrid", "gemini", "openai", or "heuristic"
AI_PROVIDER=hybrid

# Browser Automation Settings
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
